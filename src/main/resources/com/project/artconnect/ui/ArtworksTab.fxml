<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.ArtworkController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <TableView fx:id="artworkTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn" text="Title" prefWidth="200" />
            <TableColumn fx:id="artistColumn" text="Artist" prefWidth="150" />
            <TableColumn fx:id="yearColumn" text="Creation year" />
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="100" />
            <TableColumn fx:id="mediumComlumn" text="Medium" prefWidth="150" />
            <TableColumn fx:id="dimensionColumn" text="Dimensions" prefWidth="150" />
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="150" />
            <TableColumn fx:id="priceColumn" text="Price" prefWidth="100" />
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="150" />
            <TableColumn fx:id="avgRatingColumn" text="Average rating" prefWidth="100" />
        </columns>
    </TableView>
    <Label text="Comment on the the selected artwork" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
    <TableView fx:id="reviewTable" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="Select one of the Artwork above to see your comment on it."
                   style="-fx-text-fill: gray; -fx-font-style: italic;"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="ReviewRatingColumn" text="Rating out of 5" prefWidth="150" />
            <TableColumn fx:id="ReviewCommentColumn" text="Your comment" prefWidth="120" />
            <TableColumn fx:id="ReviewDateColumn" text="Date published" prefWidth="120" />
            <TableColumn fx:id="ReviewTypeColumn" text="Type" prefWidth="120" />
        </columns>
    </TableView>
    <HBox spacing="10.0" alignment="CENTER_LEFT" fx:id="buttonField">
        <Button text="Add Rating" onAction="#handleRating"/>
<!--        Buttons displayed only if you are an admin-->
<!--        <Button text="Add" onAction="#handleAdd"/>-->
<!--        <Button text="Update" onAction="#handleUpdate"/>-->
<!--        <Button text="Delete" onAction="#handleDelete"/>-->
    </HBox>
</VBox>
