<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.control.skin.TabPaneSkin.TabContentRegion?>
<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.WorkshopController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <ComboBox fx:id="filterLevel" promptText="Filter By Level" />
        <Button text="Search" onAction="#handleSearch" />
        <Button text="See my bookings" onAction="#handleSeeBookings" />
        <Button text="Reset" onAction="#handleReset" />
    </HBox>
    <TableView fx:id="workshopTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn" text="Title" prefWidth="200" />
            <TableColumn fx:id="instructorColumn" text="Instructor" prefWidth="150" />
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="150" />
            <TableColumn fx:id="priceColumn" text="Price" />
            <TableColumn fx:id="timeColumn" text="Time (min)" />
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="150" />
            <TableColumn fx:id="levelColumn" text="Level" prefWidth="100" />
            <TableColumn fx:id="nbUserInWorkshopColumn" text="Places booked" prefWidth="100" />
        </columns>
    </TableView>
    <HBox spacing="10.0" alignment="CENTER_LEFT" fx:id="buttonField">
        <Button text="Register" onAction="#handleRegister"/>
    </HBox>
</VBox>
